{
	admin off
	persist_config off
	auto_https off
	default_sni localhost
	fallback_sni localhost
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format filter {
			wrap json
			request>uri delete
			request>headers delete
		}
	}
}

https://:8443 {
	tls /dev-data/tls/cert.pem /dev-data/tls/key.pem
	route {
		request_header -X-Forwarded-For
		handle_path /index/* {
			reverse_proxy index:8080
		}
		reverse_proxy /v1/* api:8080
		reverse_proxy /rtc* livekit:7880
		respond 404
	}
}
