# Copy to deploy/.env and fill in. Keep .env private: it holds the LiveKit secret.

# Release to run. With the prefix below, `docker compose pull` fetches the
# published images; without it, Compose builds this checkout.
# Use an exact version for manual updates. To enable signed patch updates on
# a <major>.<minor> series, follow docs/operations.md#automatic-updates.
RUSTTALK_VERSION=0.2.0
RUSTTALK_IMAGE_PREFIX=ghcr.io/rusttalkcrew/

# Public IPv4 address of this host. LiveKit advertises it for media, and without
# a domain it is also the address in invites and the self-signed certificate.
RUSTTALK_IP=

# Optional public domain pointing at RUSTTALK_IP. Set it to get a Let's Encrypt
# certificate (needs ports 80 and 443 open). Leave empty for IP-only mode with a
# self-signed certificate that clients pin.
RUSTTALK_DOMAIN=

# Shared secret between the API and LiveKit. Required. Generate with:
#   openssl rand -hex 32
LIVEKIT_API_SECRET=

# Published ports. LiveKit media uses the same port number on host and container.
#RUSTTALK_HTTP_PORT=80
#RUSTTALK_HTTPS_PORT=443
#RUSTTALK_MEDIA_TCP_PORT=7881
#RUSTTALK_MEDIA_UDP_PORT=7882

# Optional signed automatic updates (profile auto-update).
#COMPOSE_FILE=docker-compose.yml:auto-update/images.yml
# Optional override of the official Ed25519 release public key.
#RUSTTALK_RELEASE_PUBLIC_KEY=
#RUSTTALK_UPDATE_HOLD_HOURS=6
#RUSTTALK_UPDATE_HOUR_UTC=4
#RUSTTALK_UPDATE_KEEP=3

# Stored file limits (bytes and seconds). Owners set them in Server settings -> Files.
# Setting one caps what owners may choose there (and becomes its default); leave them
# unset for no cap. The values shown are the defaults owners start with.
#RUSTTALK_FILE_MAX_BYTES=33554432
#RUSTTALK_FILE_MEMBER_BYTES=524288000
#RUSTTALK_FILE_SERVER_BYTES=5368709120
#RUSTTALK_FILE_TTL_SECS=2592000

# Server emoji and sticker limits: counts, and bytes per encrypted picture (at most 262144).
# RUSTTALK_STICKER_MAX works like the file limits above: unset, owners choose.
#RUSTTALK_EMOJI_MAX=100
#RUSTTALK_STICKER_MAX=50
#RUSTTALK_EMOJI_MAX_BYTES=262144

# Messages each channel keeps. Owners choose in Server settings -> Message history
# (default 10000, or all). Setting it caps what owners may choose and becomes the default;
# 0 leaves owners free and keeps everything by default. Unset: no cap.
#RUSTTALK_MESSAGE_RETAIN=10000

# How fast members may post, upload and so on: strict, standard or relaxed. Owners choose in
# Server settings -> Rate limits (default standard). Setting it caps what owners may choose
# and becomes the default. Unset: no cap.
#RUSTTALK_RATE_LIMITS=standard
